# LLM provider: "anthropic" for production, "deepseek" for cheap testing
LLM_PROVIDER=anthropic

# Testing — DeepSeek (OpenAI-compatible, ~10x cheaper than Claude)
DEEPSEEK_API_KEY=sk-...

# Production
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Database
DATABASE_URL=postgresql+asyncpg://groundtruth:password@localhost:5432/groundtruth
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=your-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GitHub
# GITHUB_MODE=mock serves canned data (dev/tests); "live" hits api.github.com
GITHUB_MODE=live
# Optional token raises rate limits (unauthenticated: 60 req/hr on public repos)
GITHUB_TOKEN=ghp_...
# Shared secret configured on the GitHub webhook; deliveries are HMAC-verified
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string

# Email
RESEND_API_KEY=re_...
FROM_EMAIL=brain@yourdomain.com

# Optional integrations
STRIPE_SECRET_KEY=sk_...
SERP_API_KEY=...
